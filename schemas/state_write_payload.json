{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GASC_StateWritePayload",
  "type": "object",
  "required": [
    "payload_id",
    "timestamp_utc",
    "ephemeral_nhi",
    "declared_evidence_boundary",
    "parent_dependency_commitments",
    "state_content",
    "content_digest_sha256",
    "agent_signature"
  ],
  "properties": {
    "node_type": {
      "type": "string",
      "enum": ["STANDARD", "COMPACTION"],
      "default": "STANDARD"
    },
    "covers": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Node IDs summarized by this compaction."
    },
    "covers_interval_gap": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Nodes in the topological interval between the earliest and latest covered nodes that are absent from covers."
    },
    "summarizer": {
      "type": "object",
      "properties": {
        "method_id": { "type": "string" },
        "config_digest": { "type": "string" }
      }
    },
    "payload_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for candidate state object."
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "ephemeral_nhi": {
      "type": "object",
      "required": ["identity_id", "session_token", "expires_at_utc"],
      "properties": {
        "identity_id": { "type": "string" },
        "session_token": { "type": "string" },
        "expires_at_utc": { "type": "string", "format": "date-time" }
      }
    },
    "declared_evidence_boundary": {
      "type": "object",
      "required": ["boundary_id", "fixed_at_utc", "boundary_digest"],
      "properties": {
        "boundary_id": { "type": "string" },
        "fixed_at_utc": { "type": "string", "format": "date-time" },
        "boundary_digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "parent_dependency_commitments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["parent_node_id", "parent_content_hash"],
        "properties": {
          "parent_node_id": { "type": "string", "format": "uuid" },
          "parent_content_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "edge_class": {
            "type": "string",
            "enum": ["MATERIAL", "INCIDENTAL", "CARRIED"],
            "default": "MATERIAL"
          }
        }
      },
      "minItems": 1
    },
    "state_content": {
      "type": "object",
      "description": "Domain-specific application state mutations."
    },
    "content_digest_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "agent_signature": {
      "type": "string",
      "description": "Cryptographic signature generated by the agent's NHI private key over payload content."
    }
  },
  "additionalProperties": false
}
